{
  "name": "@festivapp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "cli": "node --env-file-if-exists=.env src/cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@festivapp/contracts": "workspace:*",
    "@festivapp/utils": "workspace:*",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-beta.22",
    "express": "^5.2.1",
    "nanoid": "^6.0.0",
    "pg": "^8.22.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@festivapp/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.2",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "1.0.0-beta.22",
    "typescript": "^7.0.2"
  }
}
