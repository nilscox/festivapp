{
  "name": "@festivapp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env seed.ts",
    "cli": "node --env-file=.env src/cli.ts"
  },
  "dependencies": {
    "@festivapp/contracts": "workspace:*",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-beta.22",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@festivapp/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "1.0.0-beta.22",
    "typescript": "^7.0.2"
  }
}
